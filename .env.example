# =============================================================================
# DeleGate.AI — Day-0 spike environment variables
# Copy this file to `.env` and fill in real values before running any spike.
# DO NOT commit `.env`. The `.gitignore` already excludes it.
# =============================================================================

# --- Venice AI -----------------------------------------------------------------
# Get a key at https://venice.ai/ (sign in, then go to API settings).
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
# Default text model. Override per call as needed.
VENICE_TEXT_MODEL=venice-uncensored
VENICE_IMAGE_MODEL=venice-sd35
VENICE_AUDIO_VOICE=af_sky

# --- 1Shot Permissionless Relayer ----------------------------------------------
# The public relayer is permissionless — no API key required to call its
# JSON-RPC endpoint. The 1Shot relayer is MAINNET-ONLY (no testnet support
# as of the Day-0 spike). Confirmed supported chains:
#   1      = Ethereum mainnet
#   10     = Optimism
#   56     = BNB Chain
#   137    = Polygon
#   8453   = Base
#   42161  = Arbitrum One
#   42220  = Celo mainnet         ← cheapest gas, native USDC, default choice
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
ONESHOT_CHAIN_ID=42220

# Fee token (USDC on Celo by default).
# Celo USDC: 0xceba9300f2b948710d2653dd7b07f33a8b32118c (6 decimals)
# Celo USDT: 0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e (6 decimals)
ONESHOT_FEE_TOKEN=0xceba9300f2b948710d2653dd7b07f33a8b32118c

# --- Chain RPC -----------------------------------------------------------------
# Public Celo RPC. Replace with a private node (Alchemy, dRPC, …) before demo.
CHAIN_RPC_URL=https://forno.celo.org

# --- Spike signer (BURNER WALLET ONLY!) ----------------------------------------
# Private key of a throwaway test EOA you control. NEVER use a real wallet here.
# Fund this address with a tiny amount of CELO for any non-relayed txs plus
# a small amount of USDC (~$2-5) for relayer fees during the spike.
#
# CELO faucet (mainnet has no faucet — bridge or buy):
#   https://www.celoscan.io  (verify address you funded)
# Cheapest funding path: bridge $5 USDC via https://portalbridge.com or
# https://www.relay.link, then keep ~0.1 CELO for emergency native gas.
SPIKE_PRIVATE_KEY=

# --- Webhook test --------------------------------------------------------------
# After you start ngrok (see SPIKE.md), paste your https URL here.
# e.g. https://abc123.ngrok-free.app
WEBHOOK_PUBLIC_URL=
WEBHOOK_PORT=8787
