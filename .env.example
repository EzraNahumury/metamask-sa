# =============================================================================
# DeleGate.AI — Day-0 spike environment variables
# Copy this file to `.env` and fill in real values before running any spike.
# DO NOT commit `.env`. The `.gitignore` already excludes it.
# =============================================================================

# --- Venice AI -----------------------------------------------------------------
# Get a key at https://venice.ai/ (sign in, then go to API settings).
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
# Default text model. Override per call as needed.
VENICE_TEXT_MODEL=venice-uncensored
VENICE_IMAGE_MODEL=venice-sd35
VENICE_AUDIO_VOICE=af_sky

# --- 1Shot Permissionless Relayer ----------------------------------------------
# The public relayer is permissionless — no API key required to call its
# JSON-RPC endpoint. The 1Shot relayer is MAINNET-ONLY (no testnet support
# as of the Day-0 spike). Confirmed supported chains:
#   1      = Ethereum mainnet
#   10     = Optimism
#   56     = BNB Chain
#   137    = Polygon
#   8453   = Base                  ← chain of record (Venice x402 native)
#   42161  = Arbitrum One
#   42220  = Celo mainnet
#
# We chose Base because Venice's x402 inference payment rail is Base-only,
# and we want one unified wallet/chain story across Venice + merchants.
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
ONESHOT_CHAIN_ID=8453

# Fee token (USDC on Base by default).
# Base USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (6 decimals)
ONESHOT_FEE_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# --- Chain RPC -----------------------------------------------------------------
# Public Base RPC. Replace with a private node (Alchemy, Quicknode, …) before demo.
CHAIN_RPC_URL=https://mainnet.base.org

# --- Spike signer (BURNER WALLET ONLY!) ----------------------------------------
# Private key of a throwaway test EOA you control. NEVER use a real wallet here.
# Fund this address with a tiny amount of ETH for any non-relayed txs plus
# a small amount of USDC (~$5-10) for Venice x402 top-up + 1Shot relayer fees.
#
# Cheapest funding path: bridge $7-10 USDC via https://relay.link
# (Ethereum → Base) and let Relay's gas refill drop dust ETH on Base.
SPIKE_PRIVATE_KEY=

# --- Webhook test --------------------------------------------------------------
# After you start ngrok (see SPIKE.md), paste your https URL here.
# e.g. https://abc123.ngrok-free.app
WEBHOOK_PUBLIC_URL=
WEBHOOK_PORT=8787
