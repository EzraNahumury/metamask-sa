{
  "name": "delegate-ai",
  "version": "0.0.0",
  "private": true,
  "description": "DeleGate.AI — AI chief of staff for onchain money. Hackathon submission for MetaMask Smart Accounts Kit x 1Shot API x Venice AI Dev Cook Off.",
  "scripts": {
    "spike:venice": "pnpm --filter @delegate/spike run venice",
    "spike:1shot": "pnpm --filter @delegate/spike run oneshot",
    "spike:7702": "pnpm --filter @delegate/spike run upgrade7702",
    "spike:7715": "pnpm --filter @delegate/spike run grant7715",
    "spike:webhook": "pnpm --filter @delegate/spike run webhook",
    "spike:venicex402": "pnpm --filter @delegate/spike run venicex402",
    "spike:first7710": "pnpm --filter @delegate/spike run first7710",
    "spike:all": "pnpm spike:1shot && pnpm spike:venicex402"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.31.4"
    }
  }
}
