# =============================================================================
# Railway env for @delegate/merchants
# Paste into Railway → Service → Variables. Railway sets PORT itself.
# =============================================================================

# Address that receives the dust-settlement USDC for every PAY.
# Default burns it; you can point this anywhere onchain.
MERCHANT_RECIPIENT=0x000000000000000000000000000000000000dEaD

# Base mainnet RPC (only used for chain reads if you extend the service).
BASE_RPC_URL=https://mainnet.base.org
