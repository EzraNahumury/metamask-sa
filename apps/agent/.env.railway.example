# =============================================================================
# Railway env for @delegate/agent
# Paste these into Railway → Service → Variables. Railway sets PORT itself.
# =============================================================================

# Burner private key (the agent signs everything with this key).
# 64 hex chars, 0x optional. NEVER commit a real key.
SPIKE_PRIVATE_KEY=

# Where the agent reads its merchant catalog + posts /charge proofs.
# Set to the public URL of your deployed @delegate/merchants service.
MERCHANTS_BASE_URL=https://your-merchants.up.railway.app

# Frontend origin allowed to hit /decisions, /events, /admin/run-tick.
# Use exact origin (no trailing slash) or "*" for any.
AGENT_CORS_ORIGIN=https://your-dashboard.vercel.app

# Tick loop interval — how often runTick fires automatically.
AGENT_TICK_SECONDS=30

# Onchain settlement: "off" (mock only) or "dust" (small real onchain transfer
# per PAY so basescan links work in the demo).
ONCHAIN_SETTLEMENT_MODE=dust
ONCHAIN_DUST_MICRO_USDC=10000
SETTLEMENT_RECIPIENT=0x000000000000000000000000000000000000dEaD

# Base mainnet RPC. Replace with a private node before scaling.
CHAIN_RPC_URL=https://mainnet.base.org

# 1Shot relayer config (public mainnet defaults).
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
ONESHOT_CHAIN_ID=8453
ONESHOT_FEE_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Venice model defaults (override if you switch models).
VENICE_TEXT_MODEL=venice-uncensored
VENICE_IMAGE_MODEL=venice-sd35
VENICE_AUDIO_VOICE=af_sky
